# Wed Dec 13 23:32:01 CET 2023
#
# This file:    ./lathe_cmds.hal
# Created by:   /usr/src/linuxcnc/lib/hallib/basic_sim.tcl
# With options: 
# From inifile: /home/mark/kicad/motor_sturing/software/lathe/lathe.ini
# Halfiles:     LIB:basic_sim.tcl
#
# This file contains the hal commands produced by basic_sim.tcl
# (and any hal commands executed prior to its execution).
# ------------------------------------------------------------------
# To use ./lathe_cmds.hal in the original inifile (or a copy of it),
# edit to change:
#     [HAL]
#     HALFILE = LIB:basic_sim.tcl parameters
# to:
#     [HAL]
#     HALFILE = ./lathe_cmds.hal
#
# Notes:
#  1) Inifile Variables substitutions specified in the inifile
#     and interpreted by halcmd are automatically substituted
#     in the created halfile (./lathe_cmds.hal).
#  2) Input pins connected to a signal with no writer are
#     not included in the setp listings herein so must be added
#     manually
#

# user space components
loadusr -W hal_manualtoolchange

# components
#preloaded module: loadrt tpmod 
#preloaded module: loadrt homemod 
loadrt trivkins coordinates=xz 
loadrt motmod base_period_nsec=222222 servo_period_nsec=222222 num_joints=2 
loadrt etherdrive device=eth1 names=c2:00:93:15:0d:00,c2:80:12:1c:0d:00
loadrt statespace_3 count=2
loadrt absolute_index count=2

# pin aliases
# param aliases
# signals
# nets
net estop:loop iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in
net tool:change iocontrol.0.tool-change => hal_manualtoolchange.change
net tool:changed hal_manualtoolchange.changed => iocontrol.0.tool-changed
net tool:prep-loop iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net tool:prep-number iocontrol.0.tool-prep-number => hal_manualtoolchange.number

# parameter values
setp motion-command-handler.tmax    0
setp motion-controller.tmax         0
setp servo-thread.tmax              0

##################
# Control loops
##################
#
# X
#
# scale is used to convert from encoder units to mm. mm=encoder/scale
#
setp statespace_3.0.scale-0		-21845.333333333333
setp absolute_index.0.scale		-21845.333333333333
setp statespace_3.0.scale-1		1
setp statespace_3.0.A-0-0		0.0000000000e+00
setp statespace_3.0.A-0-1		0.0000000000e+00
setp statespace_3.0.A-0-2		-7.2145650766e-03
setp statespace_3.0.A-1-0		1.0000000000e+00
setp statespace_3.0.A-1-1		0.0000000000e+00
setp statespace_3.0.A-1-2		6.0934449948e-02
setp statespace_3.0.A-2-0		0.0000000000e+00
setp statespace_3.0.A-2-1		-1.0000000000e+01
setp statespace_3.0.A-2-2		1.5371988487e+00
setp statespace_3.0.B-0-0		-2.0922073275e-05
setp statespace_3.0.B-0-1		0.0000000000e+00
setp statespace_3.0.B-1-0		-8.5839745839e-05
setp statespace_3.0.B-1-1		0.0000000000e+00
setp statespace_3.0.B-2-0		-1.0616322548e-03
setp statespace_3.0.B-2-1		0.0000000000e+00
setp statespace_3.0.C-0-0		0.0000000000e+00
setp statespace_3.0.C-0-1		0.0000000000e+00
setp statespace_3.0.C-0-2		-1.0000000000e+02
setp statespace_3.0.D-0-0		-2.8999770676e-01
setp statespace_3.0.D-0-1		0.0000000000e+00
setp statespace_3.0.K-0-0		-1.6470556386e-04
setp statespace_3.0.K-1-0		5.3908674005e-04
setp statespace_3.0.K-2-0		3.1895139001e-03
setp statespace_3.0.limit-0		6.5

setp etherdrive.0.angle_offset		0
setp etherdrive.0.limit-0		0.44
setp etherdrive.0.limit-1		0.7
setp etherdrive.0.P			16
setp etherdrive.0.I			0.2
setp etherdrive.0.L			1
setp etherdrive.0.overvoltage		160
setp etherdrive.0.overcurrent		7
setp etherdrive.0.encoder		0

#
# Z
#
setp statespace_3.1.scale-0		-32768
setp statespace_3.1.scale-1		1
setp statespace_3.1.A-0-0		0.0000000000e+00
setp statespace_3.1.A-0-1		0.0000000000e+00
setp statespace_3.1.A-0-2		-2.8200014652e-02
setp statespace_3.1.A-1-0		-1.0000000000e+00
setp statespace_3.1.A-1-1		0.0000000000e+00
setp statespace_3.1.A-1-2		-1.3440738662e-01
setp statespace_3.1.A-2-0		0.0000000000e+00
setp statespace_3.1.A-2-1		1.0000000000e+01
setp statespace_3.1.A-2-2		2.0620737197e+00
setp statespace_3.1.B-0-0		2.9084105097e-04
setp statespace_3.1.B-0-1		0.0000000000e+00
setp statespace_3.1.B-1-0		3.9873977912e-04
setp statespace_3.1.B-1-1		0.0000000000e+00
setp statespace_3.1.B-2-0		-1.0836108432e-03
setp statespace_3.1.B-2-1		0.0000000000e+00
setp statespace_3.1.C-0-0		0.0000000000e+00
setp statespace_3.1.C-0-1		0.0000000000e+00
setp statespace_3.1.C-0-2		1.0000000000e+01
setp statespace_3.1.D-0-0		-1.0313507087e-01
setp statespace_3.1.D-0-1		0.0000000000e+00
setp statespace_3.1.K-0-0		-2.6983626313e-03
setp statespace_3.1.K-1-0		-1.1854009756e-02
setp statespace_3.1.K-2-0		1.3721326716e-01
setp statespace_3.1.limit-0		6.5

setp etherdrive.1.angle_offset		0
setp etherdrive.1.limit-0		0.44
setp etherdrive.1.limit-1		0.7
setp etherdrive.1.P			16
setp etherdrive.1.I			0.2
setp etherdrive.1.L			1
setp etherdrive.1.overvoltage		160
setp etherdrive.1.overcurrent		7
setp etherdrive.1.encoder		0

# realtime thread/function links
addf etherdrive.sync servo-thread
addf absolute_index.compute servo-thread
addf statespace_3.compute servo-thread
addf etherdrive.send servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread

#
# encoder2 is not used for position control, connect it anyway
#
net J0:pos-cmd joint.0.motor-pos-cmd  	=> statespace_3.0.setpoint
net J0:pos-dro statespace_3.0.position-0 => joint.0.motor-pos-fb
net J0:pos-current statespace_3.0.out 	=> etherdrive.0.Iset-1
net J0:enable joint.0.amp-enable-out 	=> etherdrive.0.enable statespace_3.0.enable
net J0:index etherdrive.0.index	=> absolute_index.0.index
net J0:pos-drive-0 etherdrive.0.position => absolute_index.0.position-in
net J0:pos-control-0 absolute_index.0.position-out => statespace_3.0.in-0
net J0:abs_fb joint.0.pos-fb => absolute_index.0.pos-fb
net J0:abs_motor joint.0.motor-offset => absolute_index.0.motor-offset

net J1:pos-cmd joint.1.motor-pos-cmd	=> statespace_3.1.setpoint
net J1:pos-dro statespace_3.1.position-0 => joint.1.motor-pos-fb
net J1:pos-current statespace_3.1.out	=> etherdrive.1.Iset-1
net J1:enable joint.1.amp-enable-out	=> etherdrive.1.enable statespace_3.1.enable
net J1:home  etherdrive.0.digin-1 => joint.1.home-sw-in
net J1:index etherdrive.1.index => absolute_index.1.index
net J1:pos-drive-0 etherdrive.1.position => absolute_index.1.position-in
net J1:pos-control-0 absolute_index.1.position-out => statespace_3.1.in-0

net coolant iocontrol.0.coolant-mist => etherdrive.0.digout-0 etherdrive.0.digout-1 

loadrt logic count=1 personality=0x1203
addf logic.0 servo-thread
net unconfigured-0 etherdrive.0.unconfigured => logic.0.in-00 halui.joint.0.unhome
net unconfigured-1 etherdrive.1.unconfigured => logic.0.in-01 halui.joint.1.unhome
net estop-on  logic.0.or => halui.estop.activate
net estop-off logic.0.nor => halui.estop.reset
