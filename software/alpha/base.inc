[FILTER]
	PROGRAM_EXTENSION = .png,.gif,.jpg Grayscale Depth Image
	PROGRAM_EXTENSION = .py Python Script
	png = image-to-gcode
	gif = image-to-gcode
	jpg = image-to-gcode
	py = python

[RS274NGC]
	PARAMETER_FILE = lathe.var
	RS274NGC_STARTUP_CODE = G18 G21 G40 G49 G54 G80 G90 G94 G7 M9 M5 G64 P0.001

[EMCMOT]
	EMCMOT = motmod
	COMM_TIMEOUT = 1.0
	SERVO_PERIOD = 222222

[TASK]
	TASK = milltask
	CYCLE_TIME = 0.001

[TRAJ]
	COORDINATES = X Z
	LINEAR_UNITS = mm
	ANGULAR_UNITS = degree
	DEFAULT_LINEAR_VELOCITY = 5.0
	MAX_LINEAR_VELOCITY = 50
	DEFAULT_LINEAR_ACCELERATION = 300
	MAX_LINEAR_ACCELERATION = 300
	POSITION_FILE=position.txt

[EMCIO]
	EMCIO = io
	CYCLE_TIME = 0.100
	TOOL_TABLE = lathe.tbl
	#TOOL_CHANGE_POSITION = 2 0 1
	TOOL_CHANGE_WITH_SPINDLE_ON = 1

[KINS]
	KINEMATICS = trivkins coordinates=xz
	JOINTS = 2

[AXIS_X]
	MIN_LIMIT = -1.0
	MAX_LIMIT = 159.0
	MAX_VELOCITY = 50
	MAX_ACCELERATION = 600

[JOINT_0]
	TYPE = LINEAR
	MAX_VELOCITY = 25
	MAX_ACCELERATION = 600
	MIN_LIMIT = -1.0
	MAX_LIMIT = 160.0
	HOME_SEQUENCE = 0
	HOME = 129.0
	HOME_OFFSET = 0
	HOME_SEARCH_VEL = 5
	HOME_LATCH_VEL =  -20
	HOME_USE_INDEX =  no
	HOME_IGNORE_LIMITS = NO
	HOME_ABSOLUTE_ENCODER = 2

[AXIS_Z]
	MIN_LIMIT = -5.0
	MAX_LIMIT = 520.0
	MAX_VELOCITY = 50
	MAX_ACCELERATION = 600

[JOINT_1]
	TYPE = LINEAR
	MAX_VELOCITY = 50
	MAX_ACCELERATION = 600
	MIN_LIMIT = -5.0
	MAX_LIMIT = 520.0
	HOME_SEQUENCE = 1
	HOME=0
	HOME_OFFSET =    0.0
	HOME_SEARCH_VEL = -25
	HOME_LATCH_VEL =   20
	HOME_USE_INDEX =   YES
	HOME_IGNORE_LIMITS = NO
	HOME_ABSOLUTE_ENCODER = 2
