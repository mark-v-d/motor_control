#*** /home/mark/kicad/motor_sturing/software/lathe_config/lathe.ini.expanded
#*** Created: Wed Feb  7 20:55:25 CET 2024
#*** Autogenerated file with expanded #INCLUDEs

[EMC] 
VERSION = 1.1
MACHINE = LinuxCNC-HAL-SIM-LATHE
DEBUG = 0
 
[DISPLAY] 
DISPLAY = axis
PYVCP = lathe.xml
LATHE = 1
CYCLE_TIME = 0.100
POSITION_OFFSET = RELATIVE
POSITION_FEEDBACK = ACTUAL
MAX_FEED_OVERRIDE = 1.2
MAX_SPINDLE_OVERRIDE = 1.0
PROGRAM_PREFIX = /home/mark/nc_files/
 
[HAL] 
HALUI = halui
HALFILE = ./lathe_cmds.hal
HALFILE = LIB:xhc-hb04.tcl
POSTGUI_HALFILE = lathe_postgui.hal
 
 

#*** Begin #INCLUDE file: base.inc
[FILTER]
	PROGRAM_EXTENSION = .png,.gif,.jpg Grayscale Depth Image
	PROGRAM_EXTENSION = .py Python Script
	png = image-to-gcode
	gif = image-to-gcode
	jpg = image-to-gcode
	py = python

[XHC_HB04_CONFIG]
	# specify layout = n for LIB:xhc-hb04-layout{n}.cfg files
	layout = 2
	# coords: specify upto 4 letters from set {x y z a b c u v w}
	# coords: switch labels are xyza but any unique 4 letters
	#         from the set {xyxabcuvw) can be used (if the coord exists)
	coords = x z
	# lowpass settings:
	# coef: slows rate of change of output,  range: 0 < coef < 1
	coefs = 1 1 1 1
	# scale plus or minus, rotaries may require larger scale factor:
	scales = -1 1 1 1
	# jogmode normal(default) or vnormal
	jogmode = normal
	# sequence 1: 0.001,0.010,0.100,1.000 (mm-based machine)
	# sequence 2: 0.001,0.005,0.010,0.020 (inch-based machine)
	# sequence 3: 0.001,0.010,0.100
	# sequence 4: 0.001,0.005,0.010,0.020,0.050,0.100
	# sequence 5: 0.001,0.010,0.050,0.100,1.000
	sequence = 1
	# require_pendant = yes|no: create xhc-hb04 hal pins when pendant not
	#                           connected at startup
	require_pendant = no
	# inch_or_mm = in | mm
	inch_or_mm = mm
	# mpg_accels: provision for reduced acceleration for manual mode jogging
	mpg_accels = 300 300 300 300

[APPLICATIONS]
	APP = monitor-xhc-hb04

[RS274NGC]
	PARAMETER_FILE = lathe.var
	RS274NGC_STARTUP_CODE = G18 G21 G40 G49 G54 G80 G90 G94 G7 M9 M5 G64 P0.001


[EMCMOT]
	EMCMOT = motmod
	COMM_TIMEOUT = 1.0
	SERVO_PERIOD = 222222

[TASK]
	TASK = milltask
	CYCLE_TIME = 0.001

[TRAJ]
	COORDINATES = X Z
	LINEAR_UNITS = mm
	ANGULAR_UNITS = degree
	DEFAULT_LINEAR_VELOCITY = 5.0
	MAX_LINEAR_VELOCITY = 50
	DEFAULT_LINEAR_ACCELERATION = 1800.0
	MAX_LINEAR_ACCELERATION = 2000.0

[EMCIO]
	EMCIO = io
	CYCLE_TIME = 0.100
	TOOL_TABLE = lathe.tbl
	#TOOL_CHANGE_POSITION = 2 0 1
	TOOL_CHANGE_WITH_SPINDLE_ON = 1

[KINS]
	KINEMATICS = trivkins coordinates=xz
	JOINTS = 2

[AXIS_X]
	MIN_LIMIT = -1.0
	MAX_LIMIT = 130.0
	MAX_VELOCITY = 50
	MAX_ACCELERATION = 2000.0

[JOINT_0]
	TYPE = LINEAR
	MAX_VELOCITY = 50
	MAX_ACCELERATION = 2000
	MIN_LIMIT = -1.0
	MAX_LIMIT = 140.0
	HOME_SEQUENCE = 0
	HOME = 129.0
	HOME_OFFSET = 130.0
	HOME_SEARCH_VEL = 5
	HOME_LATCH_VEL =  -20
	HOME_USE_INDEX =  YES
	HOME_IGNORE_LIMITS = NO

[AXIS_Z]
	MIN_LIMIT = -5.0
	MAX_LIMIT = 520.0
	MAX_VELOCITY = 50
	MAX_ACCELERATION = 2000.0

[JOINT_1]
	TYPE = LINEAR
	MAX_VELOCITY = 50
	MAX_ACCELERATION = 2000
	MIN_LIMIT = -5.0
	MAX_LIMIT = 520.0
	HOME_SEQUENCE = 1
	HOME=0
	HOME_OFFSET =    0.0
	HOME_SEARCH_VEL = -25
	HOME_LATCH_VEL =   20
	HOME_USE_INDEX =   YES
	HOME_IGNORE_LIMITS = NO

#*** End   #INCLUDE file: base.inc

#*** Begin #INCLUDE file: layout2.inc
[XHC_HB04_BUTTONS]
# use button names according to layout file LIB:xhc-hb04-layout{n}.cfg
# note: "start-pause" is connected for standard behavior
#        controlling halui.pause/halui.resume/halui.run
# these are examples, edit as required:

#
# Yellow button, create waypoint
#
goto-zero   = ""
# synthesized per-axis buttons for goto-zero button:
goto-zero-x = halui.mdi-command-00
goto-zero-y = ""
goto-zero-z = halui.mdi-command-04
goto-zero-a = ""

start-pause = std_start_pause
rewind      = halui.program.step
# probe-input for simulating a probe:
probe-z     = ""
macro-3     = halui.mdi-command-03

half        = halui.spindle.stop
# synthesized per-axis buttons for half button:
half-x      = ""
half-y      = ""
half-z      = ""
half-a      = ""

zero        = ""
# synthesized per-axis buttons for zero button:
zero-x      = halui.mdi-command-12
zero-y      = halui.mdi-command-13
zero-z      = halui.mdi-command-14
zero-a      = halui.mdi-command-15

safe-z      = halui.mdi-command-10
# in this sim, home-all only works first time, hold down till finished:
home        = halui.home-all
macro-1     = halui.mdi-command-01
macro-2     = halui.mdi-command-02
spindle     = halui.spindle.start
step        = xhc-hb04.stepsize-up
mode        = ""
macro-6     = halui.mdi-command-06
macro-7     = halui.mdi-command-07
stop        = halui.program.stop
reset       = halui.estop.activate

[HALUI]
# these are examples, edit as required:
# a halui hal pin is created for each MDI_COMMAND below
# halui.mdi-command-00, halui.mdi-command-01,... etc
# Gele knop, waypoint
MDI_COMMAND=#<waypoint_x>=#<_x>
# Macro-1
MDI_COMMAND=o<face> call
# Macro-2
MDI_COMMAND=o<simple_cycle> call [#<waypoint_x>] [#<waypoint_z>]
# Macro 3
MDI_COMMAND=(debug, example: mdi-03)
# mdi-04, Waypoint voor Z
MDI_COMMAND=#<waypoint_z>=#<_z>
MDI_COMMAND=(debug, example: mdi-05)
# Macro 6
MDI_COMMAND=(debug, example: mdi-06)
#Macro 7
MDI_COMMAND=(debug, example: mdi-07)
MDI_COMMAND=(debug, example: mdi-08)
MDI_COMMAND=(debug, example: mdi-09)
# Safe-z
MDI_COMMAND=(debug, example: mdi-10)
MDI_COMMAND=(debug, example: mdi-11)

MDI_COMMAND= G10 L20 P0 X0
MDI_COMMAND= G10 L20 P0 Y0
MDI_COMMAND= G10 L20 P0 Z0
MDI_COMMAND= G10 L20 P0 C0
#*** End   #INCLUDE file: layout2.inc
