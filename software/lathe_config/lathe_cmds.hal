# Wed Dec 13 23:32:01 CET 2023
#
# This file:    ./lathe_cmds.hal
# Created by:   /usr/src/linuxcnc/lib/hallib/basic_sim.tcl
# With options: 
# From inifile: /home/mark/kicad/motor_sturing/software/lathe/lathe.ini
# Halfiles:     LIB:basic_sim.tcl
#
# This file contains the hal commands produced by basic_sim.tcl
# (and any hal commands executed prior to its execution).
# ------------------------------------------------------------------
# To use ./lathe_cmds.hal in the original inifile (or a copy of it),
# edit to change:
#     [HAL]
#     HALFILE = LIB:basic_sim.tcl parameters
# to:
#     [HAL]
#     HALFILE = ./lathe_cmds.hal
#
# Notes:
#  1) Inifile Variables substitutions specified in the inifile
#     and interpreted by halcmd are automatically substituted
#     in the created halfile (./lathe_cmds.hal).
#  2) Input pins connected to a signal with no writer are
#     not included in the setp listings herein so must be added
#     manually
#

# user space components
loadusr -W hal_manualtoolchange

# components
#preloaded module: loadrt tpmod 
#preloaded module: loadrt homemod 
loadrt trivkins coordinates=xz 
loadrt motmod base_period_nsec=222222 servo_period_nsec=222222 num_joints=2 
loadrt etherdrive device=eth1 names=c2:00:85:0c:10:c0,c2:00:8d:11:11:c0,c2:00:03:08:10:c0
loadrt statespace_3 count=3
loadrt homer count=2
loadrt speed_controller count=1

# pin aliases
# param aliases
# signals
# nets
net estop:loop iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in
net tool:change iocontrol.0.tool-change => hal_manualtoolchange.change
net tool:changed hal_manualtoolchange.changed => iocontrol.0.tool-changed
net tool:prep-loop iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net tool:prep-number iocontrol.0.tool-prep-number => hal_manualtoolchange.number

# parameter values
setp motion-command-handler.tmax    0
setp motion-controller.tmax         0
setp servo-thread.tmax              0
##################
# Control loops
##################
#
# X
#
setp statespace_3.0.scale-0		-1000		# 1/5um
setp statespace_3.0.scale-1		-786432		# 3*2^20/4
setp statespace_3.0.A-1-1		1.0
setp statespace_3.0.B-1-0		1e-3
setp statespace_3.0.B-0-1		-9e-4
setp statespace_3.0.C-0-0		1
setp statespace_3.0.C-0-1		1
setp statespace_3.0.D-0-0		1.1610e-02
setp statespace_3.0.D-0-1		9.3991e-04
setp statespace_3.0.K-1-0		1
setp statespace_3.0.limit-0		2

setp etherdrive.0.angle_offset		-0.04
setp etherdrive.0.limit-0		0.42
setp etherdrive.0.limit-1		0.72
setp etherdrive.0.P			36
setp etherdrive.0.I			1.55
setp etherdrive.0.L			1
setp etherdrive.0.overvoltage		180
setp etherdrive.0.overcurrent		3
setp etherdrive.0.encoder		0x40000000


#
# Z
#
setp statespace_3.1.scale-0		200		# 1/5um
setp statespace_3.1.scale-1		629145.6	# 3*2^20/5
setp statespace_3.1.A-1-1		1.0
setp statespace_3.1.B-1-0		-0.002
setp statespace_3.1.B-0-1		0.0015
setp statespace_3.1.C-0-0		1
setp statespace_3.1.C-0-1		1
setp statespace_3.1.D-0-0		-0.075
setp statespace_3.1.D-0-1		-1.523841857910156e-03
setp statespace_3.1.K-1-0		1
setp statespace_3.1.limit-0		4

setp etherdrive.1.angle_offset		0.14
setp etherdrive.1.limit-0		0.44
setp etherdrive.1.limit-1		0.70
setp etherdrive.1.P			35
setp etherdrive.1.I			1.5
setp etherdrive.1.L			1
setp etherdrive.1.overvoltage		180
setp etherdrive.1.overcurrent		7

#
# Spindle
#
setp statespace_3.2.scale-0		1		# not used
setp statespace_3.2.scale-1		1		# not used
setp statespace_3.2.A-1-1		1.0
setp statespace_3.2.B-1-0		-0.002
setp statespace_3.2.B-0-1		0.0015
setp statespace_3.2.C-0-0		1
setp statespace_3.2.C-0-1		1
setp statespace_3.2.D-0-0		-0.075
setp statespace_3.2.D-0-1		-1.523841857910156e-03
setp statespace_3.2.K-1-0		1
setp statespace_3.2.limit-0		3

setp etherdrive.2.poles			4
setp etherdrive.2.encoder		3
setp etherdrive.2.angle_offset		0.88
setp etherdrive.2.limit-0		0.44
setp etherdrive.2.limit-1		0.75
setp etherdrive.2.P			40
setp etherdrive.2.I			0.2
setp etherdrive.2.L			1.55
setp etherdrive.2.overvoltage		410
setp etherdrive.2.overcurrent		15

setp speed_controller.0.V_per_speed	-18.2
#setp speed_controller.0.limit_max	0.74
#setp speed_controller.0.Vdelta		150	# Speed increase V/sec
#setp speed_controller.0.filter		0.01
#setp speed_controller.0.R		0.01
setp speed_controller.0.position_per_rev 49152
setp speed_controller.0.acceleration	1e-3
setp speed_controller.0.Imax		4
setp speed_controller.0.gain_P		-5
setp speed_controller.0.gain_I		-0.07
setp speed_controller.0.gain_L		1


setp homer.0.current-min -1.99

# realtime thread/function links
addf etherdrive.sync servo-thread
addf homer.0 servo-thread
addf homer.1 servo-thread
addf statespace_3.compute servo-thread
addf etherdrive.send servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf speed_controller.compute servo-thread


#
# We use encoder2 as the actual position, hence the swap between the
# drive and the rest of the config.
#
net J0:pos-cmd joint.0.motor-pos-cmd  	=> statespace_3.0.setpoint
#net J0:pos-fb0 etherdrive.0.position  	=> statespace_3.0.in-1
#net J0:pos-fb1 etherdrive.0.position2 	=> statespace_3.0.in-0 
net J0:pos-dro statespace_3.0.position-0 => joint.0.motor-pos-fb
net J0:pos-current statespace_3.0.out 	=> etherdrive.0.Iset-1 homer.0.current
net J0:enable joint.0.amp-enable-out 	=> etherdrive.0.enable statespace_3.0.enable
net J0:index-enable joint.0.index-enable => homer.0.index-enable
net J0:home homer.0.limit-switch 	=> joint.0.home-sw-in
net J0:index etherdrive.0.index2	=> homer.0.index-value		# index is loaded as offset
net J0:pos-drive-0 etherdrive.0.position2 => homer.0.position-in-0	# SWAPPED HERE
net J0:pos-drive-1 etherdrive.0.position  => homer.0.position-in-1	# SWAPPED HERE
net J0:pos-control-0 homer.0.position-out-0 => statespace_3.0.in-0
net J0:pos-control-1 homer.0.position-out-1 => statespace_3.0.in-1

net J1:pos-cmd joint.1.motor-pos-cmd	=> statespace_3.1.setpoint
#net J1:pos-fb0 etherdrive.1.position	=> statespace_3.1.in-1
#net J1:pos-fb1 etherdrive.1.position2	=> statespace_3.1.in-0 
net J1:pos-dro statespace_3.1.position-0 => joint.1.motor-pos-fb
net J1:pos-current statespace_3.1.out	=> etherdrive.1.Iset-1
net J1:enable joint.1.amp-enable-out	=> etherdrive.1.enable statespace_3.1.enable
net J1:home  etherdrive.0.digin-1 => joint.1.home-sw-in
net J1:index etherdrive.1.index2 => homer.1.index-value
net J1:index-enable  joint.1.index-enable homer.1.index-enable
net J1:pos-drive-0 etherdrive.1.position2 => homer.1.position-in-0	# SWAPPED HERE
net J1:pos-drive-1 etherdrive.1.position  => homer.1.position-in-1	# SWAPPED HERE
net J1:pos-control-0 homer.1.position-out-0 => statespace_3.1.in-0
net J1:pos-control-1 homer.1.position-out-1 => statespace_3.1.in-1

# spindle.0 <-> speed_controller.0/etherdrive.2
net S0:enable spindle.0.on => etherdrive.2.enable
net S0:speed spindle.0.speed-out-rps => speed_controller.0.speed
net S0:revs speed_controller.0.revs => spindle.0.revs
net S0:at_speed speed_controller.0.at_speed => spindle.0.at-speed
net S0:speed_fb speed_controller.0.speed_fb => spindle.0.speed-in
net SO:index-enable spindle.0.index-enable speed_controller.0.index_enable
net SO:index etherdrive.0.digin-0 => speed_controller.0.index


net S0:pos etherdrive.2.position => speed_controller.0.position

net S0:Vrotor etherdrive.2.Vrotor-1 => speed_controller.0.Vrotor
net S0:Vservo etherdrive.2.Vservo => speed_controller.0.Vservo

#net S0:limit speed_controller.0.limit => etherdrive.2.limit-1
net S0:current speed_controller.0.Iout => etherdrive.2.Iset-1
net S0:current-fb etherdrive.2.Irotor-1 => speed_controller.0.Irotor

net coolant iocontrol.0.coolant-mist => etherdrive.0.digout-0 etherdrive.0.digout-1 
